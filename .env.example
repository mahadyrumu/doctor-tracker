# Application Environment Variables
PORT=3000
NODE_ENV=development

# Database Connection
# Local Docker: mongodb://localhost:27017/doctor_tracker
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/doctor_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# JWT Authentication Secret (32+ chars)
JWT_SECRET=doctor_tracker_jwt_secure_secret_production_ready_2026

# Seed Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@doctortracker.com
DEFAULT_ADMIN_PASSWORD=Admin123!

